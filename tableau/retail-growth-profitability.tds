<?xml version='1.0' encoding='utf-8'?>
<datasource inline="false" name="analytics" caption="Retail Growth &amp; Profitability (synthetic)" version="9.3">
      <connection class="textscan" directory="Data" filename="monthly.csv" server="" password="" locale="en_US">
        <relation name="monthly.csv" table="[monthly.csv]" type="table">
          <columns header="yes" separator="," character-set="UTF-8">
            <column datatype="string" name="month" ordinal="0" />
            <column datatype="string" name="segment" ordinal="1" />
            <column datatype="integer" name="orders" ordinal="2" />
            <column datatype="integer" name="returns" ordinal="3" />
            <column datatype="real" name="revenue" ordinal="4" />
            <column datatype="real" name="profit" ordinal="5" />
            <column datatype="date" name="month_date" ordinal="6" />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>month</remote-name>
            <remote-type>130</remote-type>
            <local-name>[month]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>month</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>segment</remote-name>
            <remote-type>130</remote-type>
            <local-name>[segment]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>segment</remote-alias>
            <ordinal>1</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>orders</remote-name>
            <remote-type>3</remote-type>
            <local-name>[orders]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>orders</remote-alias>
            <ordinal>2</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>returns</remote-name>
            <remote-type>3</remote-type>
            <local-name>[returns]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>returns</remote-alias>
            <ordinal>3</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>revenue</remote-name>
            <remote-type>5</remote-type>
            <local-name>[revenue]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>revenue</remote-alias>
            <ordinal>4</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>profit</remote-name>
            <remote-type>5</remote-type>
            <local-name>[profit]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>profit</remote-alias>
            <ordinal>5</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>month_date</remote-name>
            <remote-type>7</remote-type>
            <local-name>[month_date]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>month_date</remote-alias>
            <ordinal>6</ordinal>
            <local-type>date</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <column name="[month]" caption="Month" datatype="string" role="dimension" type="nominal" />
      <column name="[segment]" caption="Segment" datatype="string" role="dimension" type="nominal" />
      <column name="[orders]" caption="Orders" datatype="integer" role="measure" type="quantitative" />
      <column name="[returns]" caption="Returns" datatype="integer" role="measure" type="quantitative" />
      <column name="[revenue]" caption="Revenue" datatype="real" role="measure" type="quantitative" />
      <column name="[profit]" caption="Profit" datatype="real" role="measure" type="quantitative" />
      <column name="[month_date]" caption="Month Date" datatype="date" role="dimension" type="nominal" />
      <column name="[Calculation_KPI_0]" caption="Net revenue" datatype="real" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM([revenue])" />
      </column>
      <column name="[Calculation_KPI_1]" caption="Contribution profit" datatype="real" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM([profit])" />
      </column>
      <column name="[Calculation_KPI_2]" caption="Contribution margin" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="IF SUM([revenue]) = 0 THEN NULL ELSE SUM([profit]) / SUM([revenue]) END" />
      </column>
      <column name="[Calculation_KPI_3]" caption="Return rate" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="IF SUM([orders]) = 0 THEN NULL ELSE SUM([returns]) / SUM([orders]) END" />
      </column>
    </datasource>
  