{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "Trend",
  "position": {
    "x": 20,
    "y": 190,
    "width": 800,
    "height": 300,
    "z": 4,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "DimDate.Month",
              "nativeQueryRef": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactMonthly"
                    }
                  },
                  "Property": "Net revenue"
                }
              },
              "queryRef": "FactMonthly.Net revenue",
              "nativeQueryRef": "Net revenue"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}